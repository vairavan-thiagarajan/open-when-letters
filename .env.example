SITE_URL=https://openwhenletters.in

# ── Email (server-side only — set in the Vercel dashboard, never VITE_-prefixed) ──
# Resend sending. Verify the openwhenletters.in domain in Resend first so the
# "from" address is allowed.
RESEND_API_KEY=
EMAIL_FROM=Open When Letters <hello@openwhenletters.in>
# Canonical public origin used for every link inside emails.
APP_URL=https://openwhenletters.in

# ── Supabase email verification (manual, one-time setup) ──
# To route Supabase's own verification email through Resend:
#  1. Supabase dashboard → Authentication → SMTP Settings:
#       Host: smtp.resend.com   Port: 465
#       Username: RESEND_API_KEY   Password: RESEND_API_KEY
#       Sender: the EMAIL_FROM address above
#  2. Authentication → Email Templates → "Confirm signup":
#       Subject: Verify your email
#       Body: a branded template using {{ .ConfirmationURL }} (links to
#             <APP_URL>/login?verified=1 via emailRedirectTo in authContext)
# Recommended: the service role key so the server can write the email_log
# dedup table behind RLS. Get it from Supabase → Settings → API.
SUPABASE_SERVICE_ROLE_KEY=
